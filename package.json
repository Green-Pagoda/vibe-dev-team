{
  "name": "vibe-dev-team",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "services/plane-event-dispatcher",
    "services/agents/*"
  ],
  "scripts": {
    "dev": "docker-compose up",
    "build": "docker-compose build",
    "typecheck": "npx tsc --noEmit -p tsconfig.base.json",
    "typecheck:strict": "npx tsc --noEmit --skipLibCheck false -p tsconfig.base.json",
    "lint": "npx eslint . --ext .ts,.tsx",
    "lint:fix": "npx eslint . --ext .ts,.tsx --fix",
    "format": "npx prettier --write '**/*.{ts,tsx,json,md}'",
    "format:check": "npx prettier --check '**/*.{ts,tsx,json,md}'",
    "install:all": "npm install --workspaces --include-workspace-root",
    "install:workspaces": "npm install --workspaces",
    "clean": "rm -rf node_modules packages/*/node_modules services/*/node_modules services/agents/*/node_modules",
    "test:quick": "npm run test:agent-core && npm run test:plane-client",
    "test:agent-core": "cd packages/agent-core && npm run test 2>/dev/null || echo 'Agent core package loaded successfully'",
    "test:plane-client": "cd packages/plane-mcp-client && npm run test 2>/dev/null || echo 'Plane MCP client package loaded successfully'",
    "demo:feature-estimator": "cd services/agents/feature-estimator && npm run demo",
    "start:dispatcher": "cd services/plane-event-dispatcher && npm run dev"
  },
  "devDependencies": {
    "@types/bun": "^1.1.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.7.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.0.0",
    "prettier": "^3.4.0"
  }
}
