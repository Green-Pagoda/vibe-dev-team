# Plane Configuration (using official MCP server)
PLANE_API_KEY=your_plane_api_key_here
PLANE_WORKSPACE_SLUG=your_workspace_slug
PLANE_API_HOST_URL=https://api.plane.so
PLANE_WEBHOOK_SECRET=your_webhook_secret_here

# LLM Configuration
LLM_PROVIDER=openai
LLM_MODEL=gpt-4
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2000
OPENAI_API_KEY=your_openai_api_key_here

# Agent Configuration
AGENT_TIMEOUT=30000
AGENT_RETRIES=3
AGENT_LOG_LEVEL=info

# Mastra Configuration
MASTRA_CONFIG_PATH=./config/mastra.json

# Service Ports
DISPATCHER_PORT=3000
FEATURE_ESTIMATOR_PORT=3001

# Environment
NODE_ENV=development